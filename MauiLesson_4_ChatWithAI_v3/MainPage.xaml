<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiLesson_4_ChatWithAI_v3.MainPage">

    <Grid RowDefinitions="Auto, *, Auto" Padding="10">

        <Border Grid.Row="0" Stroke="#555555" StrokeThickness="1" StrokeShape="RoundRectangle 5"
                BackgroundColor="#2B2D31" Padding="12, 4" Margin="0, 0, 0, 10">
            <Grid ColumnDefinitions="Auto, *">
                <Label Text="Модель:" TextColor="#A0A0A0" VerticalOptions="Center" Margin="0,0,10,0"/>
                <Picker x:Name="ModelPicker" Grid.Column="1" TextColor="White" Title="Оберіть модель"
                        ItemDisplayBinding="{Binding Name}" />
            </Grid>
        </Border>

        <CollectionView x:Name="ChatList" Grid.Row="1" Margin="0,0,0,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,8" Margin="5"
                            HorizontalOptions="{Binding Alignment}"
                            BackgroundColor="{Binding BackgroundColor}"
                            StrokeThickness="2" StrokeShape="RoundRectangle 12">
                        <Label Text="{Binding FormattedText}" TextType="Html" TextColor="Black" FontSize="16" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator x:Name="LoadingIndicator" Grid.Row="1" IsRunning="False" IsVisible="False"
                           HorizontalOptions="Center" VerticalOptions="Center" Color="DarkSlateGrey"/>

        <Border Grid.Row="2" Stroke="#555555" StrokeThickness="1" StrokeShape="RoundRectangle 5"
                BackgroundColor="#2B2D31" Padding="15, 5" Margin="0, 10, 0, 0">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <Editor x:Name="MessageInput" Grid.Column="0" Placeholder="Введіть запит..." 
                        TextColor="White" PlaceholderColor="#A0A0A0" BackgroundColor="Transparent"
                        AutoSize="TextChanges" MaximumHeightRequest="120" VerticalOptions="Center"
                        TextChanged="OnMessageInputTextChanged" />

                <Button x:Name="MicButton" Grid.Column="1" Text="🎙️" FontSize="20" BackgroundColor="Transparent"
                        TextColor="White" CornerRadius="18" WidthRequest="40" HeightRequest="40"
                        Padding="0" VerticalOptions="End" Margin="5, 5, 5, 5" Clicked="OnMicClicked"/>

                <Button x:Name="SendButton" Grid.Column="2" Text="⌕" FontSize="20" FontAttributes="Bold"
                        BackgroundColor="#23A559" TextColor="White" CornerRadius="18" WidthRequest="36" HeightRequest="36"
                        Padding="0" VerticalOptions="End" Margin="5, 5, 0, 5" IsEnabled="False" Clicked="OnSendClicked"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>